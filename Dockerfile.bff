FROM node:22-alpine AS builder
WORKDIR /app
# Full repo needed: prebuild copies proto files from sibling Kotlin services
COPY . .
RUN corepack enable && pnpm install --frozen-lockfile
RUN pnpm --filter @pokemon-pricer/bff run build
# --legacy: BFF has no workspace package dependencies, so injected mode is unnecessary
RUN pnpm deploy --filter @pokemon-pricer/bff --prod --legacy /deploy/bff

FROM node:22-alpine
WORKDIR /app
COPY --from=builder /deploy/bff .
EXPOSE 3000
CMD ["node", "dist/index.js"]
